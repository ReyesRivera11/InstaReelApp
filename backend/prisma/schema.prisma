generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model user {
  id             Int              @id @default(autoincrement())
  first_name     String
  last_name      String
  email          String           @unique
  password       String
  refresh_tokens refresh_tokens[]
}

model refresh_tokens {
  id      Int    @id @default(autoincrement())
  user_id Int
  token   String
  user    user   @relation(fields: [user_id], references: [id])
}

model client {
  id               Int             @id @default(autoincrement())
  name             String
  username         String          @unique
  description      String?
  insta_id         String?
  long_lived_token String?         @db.VarChar(250)
  social_identity  SocialIdentity
  reels            reels[]
  tiktok_account   tiktok_account?
  tiktok_reels     tiktok_reels[]
  x_account      x_account?
  x_posts          x_posts[]
}

model reels {
  id                 Int            @id @default(autoincrement())
  client_id          Int
  status             ReelStatus     @default(SCHEDULED)
  title              String
  social_identity    SocialIdentity
  description        String?
  video_url          String?
  scheduled_date     DateTime?
  container_media_id String?        @unique
  created_at         DateTime       @default(now())
  client             client         @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model tiktok_account {
  id            Int      @id @default(autoincrement())
  client_id     Int      @unique
  open_id       String   @unique
  access_token  String   @db.VarChar(500)
  refresh_token String   @db.VarChar(500)
  expires_at    DateTime
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  client        client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model tiktok_reels {
  id                Int              @id @default(autoincrement())
  client_id         Int
  title             String
  description       String?
  video_url         String
  privacy_level     String
  scheduled_at      DateTime?
  published_at      DateTime?
  status            TikTokReelStatus @default(SCHEDULED)
  publish_id        String?          @unique
  video_id          String?          @unique
  error_message     String?
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  allow_comment     Boolean          @default(false)
  allow_duet        Boolean          @default(false)
  allow_stitch      Boolean          @default(false)
  brand_self        Boolean          @default(false)
  brand_third_party Boolean          @default(false)
  is_commercial     Boolean          @default(false)
  client            client           @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([status, scheduled_at])
}

model x_account {
  id                   Int      @id @default(autoincrement())

  // 🔑 FK + UNIQUE → 1–1
  client_id            Int      @unique
  client               client  @relation(fields: [client_id], references: [id], onDelete: Cascade)

  // identidad X
  x_user_id            String
  username             String

  // OAuth 2.0
  access_token         String
  refresh_token        String?
  expires_at           DateTime?

  // OAuth 1.0a
  oauth1_token         String?
  oauth1_token_secret  String?

  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

model x_posts {
  id        Int    @id @default(autoincrement())
  client_id Int
  client    client @relation(fields: [client_id], references: [id], onDelete: Cascade)

  text String @db.VarChar(280)

  /**
   * 👇 NUEVO
   */
  media_url  String?     @db.VarChar(500)
  media_type XMediaType?

  status XPostStatus @default(SCHEDULED)

  tweet_id      String?   @unique
  scheduled_at  DateTime
  published_at  DateTime?
  error_message String?

  created_at DateTime @default(now())
}

model x_oauth1_sessions {
  oauth_token        String @id
  oauth_token_secret String
  client_id          Int
  created_at         DateTime @default(now())
}


enum SocialIdentity {
  INSTAGRAM
  FACEBOOK
  X
  TIKTOK
}

enum ReelStatus {
  SCHEDULED
  PUBLISHED
}

enum TikTokReelStatus {
  SCHEDULED
  PROCESSING
  PUBLISHED
  FAILED
}

enum XPostStatus {
  SCHEDULED
  PUBLISHED
  FAILED
}

enum XMediaType {
  IMAGE
  VIDEO
}
